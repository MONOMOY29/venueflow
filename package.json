{
  "name": "venueflow",
  "version": "1.0.0",
  "description": "AI-powered smart venue crowd management and navigation assistant for large-scale events",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watchAll"
  },
  "keywords": [
    "venue",
    "crowd-management",
    "gemini",
    "google-ai",
    "smart-navigation",
    "event-management"
  ],
  "author": "VenueFlow Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "server.js",
      "!node_modules/**"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
